# Copy to .env.local (or set in your host's environment) and fill in what you use.
# Anything left empty is hidden in the app.

# Stripe Payment Links for the Donate dialog (Stripe dashboard → Payment Links).
# Tip: set each link's "After payment" redirect to https://<your-site>/?thanks
# so supporters land back on the site with a thank-you message.
VITE_DONATE_LINK_3=
VITE_DONATE_LINK_5=
VITE_DONATE_LINK_10=
# A Payment Link set to "Let customers choose what to pay".
VITE_DONATE_LINK_CUSTOM=
# Currency of the preset amounts above (display only).
VITE_DONATE_CURRENCY=USD

# Public contact address for the About page. Stripe requires contact details
# on sites that take payments.
VITE_CONTACT_EMAIL=

# Link to the source code.
VITE_SOURCE_URL=https://github.com/skynab/BackSubtract
